{
  "expo": {
    "name": "Money Trackr",
    "slug": "money-trackr-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "moneytrackr",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6366f1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6366f1",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.moneytrackr.mobile",
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moneytrackr.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "@react-native-google-signin/google-signin",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Money Trackr needs access to your photos so you can set a profile picture.",
          "cameraPermission": "Money Trackr needs camera access so you can take a profile picture."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d1568783-6dda-4b6a-9ffb-a427f6038264"
      }
    }
  }
}
